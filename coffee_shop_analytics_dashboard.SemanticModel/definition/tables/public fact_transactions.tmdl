	column is_weekend = IF('public fact_transactions'[day_of_week] >= 5 , 1, 0)
		formatString: 0
		lineageTag: 3f55e4f6-f880-4fc7-87e7-fe751833c262
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Day Type' =
			IF(
			    'public fact_transactions'[is_weekend] = 1,
			    "Weekend",
			    "Weekday"
			)
		lineageTag: 023ca642-881c-4f6f-a75a-82465a31a188
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Day Name' =
			
			SWITCH(
			    'public fact_transactions'[day_of_week],
			    1, "Mon",
			    2, "Tue",
			    3, "Wed",
			    4, "Thu",
			    5, "Fri",
			    6, "Sat",
			    7, "Sun"
			)
		lineageTag: 74ece20d-4e8d-4799-93a6-9e2428e76dc0
		summarizeBy: none
		sortByColumn: day_of_week

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Shift =
			
			IF(
			    'public fact_transactions'[transaction_hour] >= 6 &&
			    'public fact_transactions'[transaction_hour] <= 11,
			    "Morning sales",
			    "Afternoon sales"
			)
		lineageTag: da1ed3a9-d463-485b-b34e-9927b0974093
		summarizeBy: none

