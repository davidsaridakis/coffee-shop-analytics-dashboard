                  {
                    "value": "Insight 1:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#4e342e"
                    }
                  },
                  {
                    "value": " Around 58% of bakery sales happen before midday, confirming that bakery demand is heavily concentrated in the morning.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#4e342e"
                    }
                  }
