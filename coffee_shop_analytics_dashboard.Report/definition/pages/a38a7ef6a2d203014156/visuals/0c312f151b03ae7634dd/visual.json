                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Business implication:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#4e342e"
                    }
                  },
                  {
                    "value": "  Most bakery preparation should be completed before opening, with staffing and production focused on the morning rush.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#4e342e"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
