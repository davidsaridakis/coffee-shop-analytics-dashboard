                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Insight 2:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#4e342e"
                    }
                  },
                  {
                    "value": " Although sales fluctuate slightly throughout the week, the overall bakery pattern remains remarkably consistent from day to day.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#4e342e"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Business implication:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#4e342e"
                    }
                  },
                  {
                    "value": "   A consistent daily production schedule is likely to be more effective than making large adjustments for different weekdays..",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#4e342e"
                    }
